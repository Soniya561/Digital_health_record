# Backend Environment Configuration - DEPLOYMENT READY
# Copy this file to .env and update with your actual values

# Server Configuration
# PORT is automatically set by Render, but can be overridden
PORT=4001

# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb+srv://user:password@cluster0.mongodb.net/mydb?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_jwt_secret_here_use_a_strong_random_string
JWT_EXPIRES_IN=7d

# Encryption key (base64) used by crypto util
ENC_KEY_BASE64=your_base64_encoded_encryption_key

# Email Configuration
EMAIL_MODE=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@yourdomain.com

# AI Configuration (Groq or other provider)
AI_API_KEY=your_ai_api_key_here
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

